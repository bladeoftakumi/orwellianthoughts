{
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs20",
    "ignore": ["node_modules", ".git", "*.local"],
    "predeploy": [
      "node -e \"require('fs').copyFileSync('schema.js', 'functions/schema.mjs')\""
    ]
  }
}
